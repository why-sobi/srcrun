#!/usr/bin/env bash

# 1. Resolve the absolute path of the directory containing this launcher script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"
VENV_PYTHON="$VENV_DIR/bin/python"

# 2. Check if script name was provided
if [ -z "$1" ]; then
    echo "Error: No script name provided."
    echo "Usage: srcrun <script_name> [args...]"
    exit 1
fi

SCRIPT_NAME="$1"
shift  # Discard script name, leaving only optional flags/args in "$@"

TARGET_PY="$SCRIPT_DIR/$SCRIPT_NAME.py"

# 3. Ensure virtual environment exists
if [ ! -f "$VENV_PYTHON" ]; then
    echo "[.venv not found in $SCRIPT_DIR. Creating virtual environment...]"
    python3 -m venv "$VENV_DIR"
    if [ $? -ne 0 ]; then
        echo "Error: Failed to create virtual environment."
        exit 1
    fi
    echo "[.venv created successfully.]"
fi

# 4. Verify Python script exists before executing
if [ -f "$TARGET_PY" ]; then
    "$VENV_PYTHON" "$TARGET_PY" "$@"
else
    echo "Error: Script '$SCRIPT_NAME.py' not found in $SCRIPT_DIR"
    exit 1
fi